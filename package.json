{
  "name": "website-security-scanner",
  "version": "1.0.5",
  "private": true,
  "description": "Development and release tools for the Chrome extension",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "check": "node scripts/check.cjs",
    "package": "node scripts/package.cjs",
    "test:live": "node scripts/live-smoke.cjs",
    "format": "prettier --write \"*.{js,json,html,css,md}\" \"scripts/*.cjs\" \"tests/*.cjs\"",
    "format:check": "prettier --check \"*.{js,json,html,css,md}\" \"scripts/*.cjs\" \"tests/*.cjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=22"
  }
}
